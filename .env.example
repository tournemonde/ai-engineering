# LLM provider: openai | anthropic
LLM_PROVIDER=openai

# Model name (defaults depend on provider if left empty)
# OpenAI: gpt-4o-mini
# Anthropic: claude-haiku-4-5
LLM_MODEL=

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=

# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

APP_ENV=development
LOG_LEVEL=DEBUG
